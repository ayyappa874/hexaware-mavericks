# Environment Variables for Survey Sentinel

# PostgreSQL Database
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_pass
POSTGRES_DB=survey_sentinel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel_user:sentinel_pass@localhost:5432/survey_sentinel_db
DATABASE_URL_DOCKER=postgresql://sentinel_user:sentinel_pass@postgres:5432/survey_sentinel_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# Security / JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
